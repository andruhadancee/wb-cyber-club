# ── Домен и SSL ──
DOMAIN=example.com
SSL_EMAIL=admin@example.com

# ── PostgreSQL ──
POSTGRES_USER=cyberclub
POSTGRES_PASSWORD=cyberclub
POSTGRES_DB=cyberclub

# ── App ──
PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://cyberclub:cyberclub@postgres:5432/cyberclub

